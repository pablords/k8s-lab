{
  "title": "Marketplace - Logs Centralizados",
  "uid": "marketplace-logs",
  "tags": ["marketplace", "logs", "lucene"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "label": "Serviço",
        "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-logs" },
        "definition": "{\"find\":\"terms\",\"field\":\"container_name\"}",
        "query": "{\"find\":\"terms\",\"field\":\"container_name\"}",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "level",
        "type": "custom",
        "label": "Nível",
        "query": "DEBUG,INFO,WARN,ERROR",
        "multi": false,
        "includeAll": true,
        "current": { "text": "All", "value": "*" }
      },
      {
        "name": "search",
        "type": "textbox",
        "label": "Pesquisar Texto",
        "query": "*",
        "current": { "text": "*", "value": "*" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Stream de Logs em Tempo Real",
      "description": "Use Lucene: level:ERROR, trace_id:\"abc\", message:*timeout*",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-logs" },
      "targets": [
        {
          "refId": "A",
          "query": "level:$level AND container_name:$service AND NOT container_name:*prometheus* AND NOT container_name:*fluent-bit* $search",
          "metrics": [{ "type": "logs", "id": "1" }],
          "timeField": "@timestamp",
          "bucketAggs": []
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 2,
      "title": "Taxa de Erros por Serviço (ERROR/WARN)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-logs" },
      "targets": [
        {
          "refId": "A",
          "query": "level:(ERROR OR error OR WARN OR warn) AND container_name:$service AND *$search*",
          "metrics": [{ "type": "count", "id": "1" }],
          "timeField": "@timestamp",
          "bucketAggs": [
            {
              "type": "date_histogram",
              "field": "@timestamp",
              "id": "2",
              "settings": { "interval": "auto", "min_doc_count": "0" }
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "red" }, "custom": {} }
      }
    },
    {
      "id": 3,
      "title": "Volume de Logs por Nível",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-logs" },
      "targets": [
        {
          "refId": "A",
          "query": "container_name:$service $search",
          "metrics": [{ "type": "count", "id": "1" }],
          "timeField": "@timestamp",
          "bucketAggs": [
            {
              "type": "terms",
              "field": "level",
              "id": "2",
              "settings": { "size": "10", "order": "desc", "orderBy": "1" }
            }
          ]
        }
      ]
    },
    {
      "id": 4,
      "title": "🔍 Logs por Trace ID (Correlação com Jaeger)",
      "description": "Cole um trace_id do Jaeger para ver todos os logs da requisição: trace_id:\"SEU_TRACE_ID\"",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-logs" },
      "targets": [
        {
          "refId": "A",
          "query": "(level:ERROR OR level:error OR level:WARN OR level:warn) AND container_name:$service $search",
          "metrics": [{ "type": "logs", "id": "1" }],
          "timeField": "@timestamp",
          "bucketAggs": []
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 5,
      "title": "Top 10 Erros Mais Frequentes",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 30 },
      "datasource": { "type": "grafana-opensearch-datasource", "uid": "opensearch-logs" },
      "targets": [
        {
          "refId": "A",
          "query": "(level:ERROR OR level:error) AND container_name:$service $search",
          "metrics": [{ "type": "count", "id": "1" }],
          "timeField": "@timestamp",
          "bucketAggs": [
            {
              "type": "terms",
              "field": "msg.keyword",
              "id": "2",
              "settings": { "size": "10", "order": "desc", "orderBy": "1", "missing": "N/A" }
            }
          ]
        }
      ]
    }
  ]
}
