{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Concurrency & Resources",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "go_sched_goroutines_goroutines", "legendFormat": "Goroutines", "refId": "A" },
        { "expr": "go_threads", "legendFormat": "OS Threads", "refId": "B" },
        { "expr": "go_sched_gomaxprocs_threads", "legendFormat": "GOMAXPROCS", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 2,
      "title": "Scheduling Latency (P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(go_sched_latencies_seconds_bucket[5m])) by (le, job))", "legendFormat": "{{job}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "title": "GC & Runtime STW Pauses (P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(go_sched_pauses_stopping_gc_seconds_bucket[5m])) by (le, job))", "legendFormat": "Stop GC: {{job}}", "refId": "A" },
        { "expr": "histogram_quantile(0.99, sum(rate(go_sched_pauses_stopping_other_seconds_bucket[5m])) by (le, job))", "legendFormat": "Stop Other: {{job}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 4,
      "title": "Total Pause Time Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "rate(go_sched_pauses_total_gc_seconds_sum[1m])", "legendFormat": "GC Pause Rate", "refId": "A" },
        { "expr": "rate(go_sched_pauses_total_other_seconds_sum[1m])", "legendFormat": "Other Pause Rate", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "title": "Mutex Wait Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        { "expr": "rate(go_sync_mutex_wait_total_seconds_total[1m])", "legendFormat": "Wait Duration (s/s)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["go", "runtime", "infra"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "Go Runtime - Health & Performance",
  "uid": "go-runtime-health"
}
