        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"indexing-service\", status=~\"4..\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=\"indexing-service\"}[1m]))) * 100",
