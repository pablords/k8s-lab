      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"indexing-service\", status=~\"2..\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=\"indexing-service\"}[1m]))) * 100",
