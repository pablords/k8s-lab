        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"indexing-service\", status=~\"5..\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=\"indexing-service\"}[1m]))) * 100",
          "legendFormat": "Server Errors (5xx)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
